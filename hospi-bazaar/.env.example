# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=hospi_bazaar

# API server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Payments. Leave the Razorpay keys empty to run in mock mode (payments are simulated).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PAYMENT_MODE=mock

# Email notifications are sent only when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Hospi Bazaar <no-reply@example.com>

# Uploaded files (local disk)
UPLOADS_DIR=
MAX_UPLOAD_MB=10

# Set to false to stop the background jobs (negotiation expiry, auto-confirm delivery, email sending)
RUN_JOBS=true
